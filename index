<script>
(function() {
  const DURATION = 15 * 60;
  const KEY = 'jb_cd_end_v2';
  let endTime = parseInt(sessionStorage.getItem(KEY) || '0');
  const now = Math.floor(Date.now() / 1000);
  if (!endTime || endTime <= now) { endTime = now + DURATION; sessionStorage.setItem(KEY, endTime); }
  function pad(n) { return String(n).padStart(2, '0'); }
  function tick() {
    const remaining = Math.max(0, endTime - Math.floor(Date.now() / 1000));
    const h = Math.floor(remaining / 3600), m = Math.floor((remaining % 3600) / 60), s = remaining % 60;
    const hh = pad(h), mm = pad(m), ss = pad(s);
    ['cdH','cdH2'].forEach(id => { const el = document.getElementById(id); if(el) el.textContent = hh; });
    ['cdM','cdM2'].forEach(id => { const el = document.getElementById(id); if(el) el.textContent = mm; });
    ['cdS','cdS2'].forEach(id => { const el = document.getElementById(id); if(el) el.textContent = ss; });
    if (remaining > 0) setTimeout(tick, 1000);
  }
  tick();
})();

document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const item = btn.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  });
});

document.querySelectorAll('.rc-carousel').forEach(carousel => {
  const track = carousel.querySelector('.rc-track');
  const dotsWrap = carousel.querySelector('.rc-dots');
  const btnPrev = carousel.querySelector('.rc-prev');
  const btnNext = carousel.querySelector('.rc-next');
  const slides = Array.from(track.querySelectorAll('.rc-slide'));
  const total = slides.length;
  if (total === 0) return;
  let current = 0;
  const dots = [];
  for (let i = 0; i < total; i++) {
    const d = document.createElement('button');
    d.classList.add('rc-dot');
    d.setAttribute('aria-label', `Slide ${i + 1}`);
    if (i === 0) d.classList.add('active');
    d.addEventListener('click', () => goTo(i));
    dotsWrap.appendChild(d);
    dots.push(d);
  }
  function goTo(n) {
    current = ((n % total) + total) % total;
    track.scrollTo({ left: current * track.offsetWidth, behavior: 'smooth' });
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }
  track.addEventListener('scroll', () => {
    const idx = Math.round(track.scrollLeft / track.offsetWidth);
    if (idx !== current) { current = idx; dots.forEach((d, i) => d.classList.toggle('active', i === current)); }
  }, { passive: true });
  btnPrev.addEventListener('click', () => goTo(current - 1));
  btnNext.addEventListener('click', () => goTo(current + 1));
});

(function() {
  const inner = document.getElementById('tcInner');
  const track = document.getElementById('tcTrack');
  const dotsWrap = document.getElementById('tcDots');
  const btnPrev = document.querySelector('.tc-prev');
  const btnNext = document.querySelector('.tc-next');
  if (!inner || !track) return;
  const slides = Array.from(inner.querySelectorAll('.tc-slide'));
  const total = slides.length;
  if (total === 0) return;
  let current = 0;
  const dots = [];
  for (let i = 0; i < total; i++) {
    const d = document.createElement('button');
    d.classList.add('tc-dot');
    if (i === 0) d.classList.add('active');
    d.setAttribute('aria-label', `Testimonio ${i + 1}`);
    d.addEventListener('click', () => goTo(i));
    dotsWrap.appendChild(d);
    dots.push(d);
  }
  function goTo(n) {
    current = ((n % total) + total) % total;
    inner.style.transform = `translateX(-${current * track.offsetWidth}px)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  }
  window.addEventListener('resize', () => {
    inner.style.transition = 'none';
    inner.style.transform = `translateX(-${current * track.offsetWidth}px)`;
    requestAnimationFrame(() => { inner.style.transition = ''; });
  });
  btnPrev && btnPrev.addEventListener('click', () => goTo(current - 1));
  btnNext && btnNext.addEventListener('click', () => goTo(current + 1));
  let tSX = 0, tDX = 0;
  track.addEventListener('touchstart', e => { tSX = e.touches[0].clientX; tDX = 0; }, { passive: true });
  track.addEventListener('touchmove', e => { tDX = e.touches[0].clientX - tSX; }, { passive: true });
  track.addEventListener('touchend', () => { if (Math.abs(tDX) > 40) goTo(tDX < 0 ? current + 1 : current - 1); });
  setInterval(() => goTo(current + 1), 4000);
})();

(function() {
  var ctaReady = false;
  window.handleCtaClick = function(e) {
    const btn = document.getElementById('ctaHotmartBtn');
    if (!ctaReady) {
      e.preventDefault();
      fbq('track', 'InitiateCheckout');
      const block = document.getElementById('ctaCountdownBlock');
